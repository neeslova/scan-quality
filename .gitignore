# Данные и веса — никогда в репозиторий.
# Ведущий слэш обязателен: без него шаблон применяется на ЛЮБОЙ глубине, и
# `data/` выбрасывает не только data/ в корне, но и пакет src/data/ вместе
# с src/models/. Локально это незаметно — файлы на диске, — а на чистом клоне
# половина проекта просто отсутствует.
/data/
/models/
/runs/
/reports/*
!/reports/.gitkeep

# окружение
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# инструменты
.claude/
.vscode/
.idea/
.ipynb_checkpoints/
gradio_cached_examples/
*.log
